<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"> <!-- 形状可为矩形、椭圆等，默认矩形 -->

    <!-- 圆角半径 -->
    <corners
        android:radius="6dp" />

    <!-- 边框样式 -->
    <stroke
        android:width="1dp"
    android:color="#FFC3C3C3" />

    <!-- 背景填充色（可选，透明背景则设为@android:color/transparent） -->
    <solid android:color="#FFF6F5F3" />

</shape>