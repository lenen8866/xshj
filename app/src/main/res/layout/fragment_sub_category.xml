<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context="com.sda.books.reader.MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- 顶部标签栏 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/sub_category_tab"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@android:color/transparent"
            app:tabGravity="start"
            app:tabIndicator="@android:color/transparent"
            app:tabIndicatorColor="#FFFF7D0D"
            app:tabMode="scrollable"
            app:tabSelectedTextAppearance="@style/subCategorySelectTxt"
            app:tabSelectedTextColor="@color/black"
            app:tabTextAppearance="@style/subCategoryUnSelectTxt"
            app:tabTextColor="#FF979797" />

        <!-- 内容区域 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/volume_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>