<?xml version="1.0" encoding="utf-8"?>
<com.ansen.shape.AnsenLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    app:solid_color="@color/white"
    app:corners_radius="5dp"
    >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="更新通知"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#333"
        android:textSize="14sp"
        />
    <com.ansen.shape.AnsenLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:solid_color="#f5f5f5"
        app:corners_radius="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:padding="10dp"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="当前"
                android:textColor="#333"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/tv_old_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="1.0.0"
                android:textColor="#333"
                android:textStyle="bold"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text=" ----> "
                android:textColor="#333"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/tv_new_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="1.0.0"
                android:textColor="#333"
                android:textStyle="bold"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:id="@+id/tv_app_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="370M"
                android:textColor="@color/color_999"
                android:textStyle="bold"
                />


        </LinearLayout>
        <TextView
            android:id="@+id/tv_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#333"
            android:textSize="16sp"
            android:padding="10dp"
            />
    </com.ansen.shape.AnsenLinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <com.ansen.shape.AnsenTextView
            android:id="@+id/tv_cancel"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/color_999"
            android:text="取消"
            app:solid_color="#f5f5f5"
            app:corners_radius="5dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <com.ansen.shape.AnsenTextView
            android:id="@+id/tv_sure"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#fff"
            android:text="确认"
            app:solid_color="#FF7D0D"
            app:corners_radius="5dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

    </LinearLayout>


</com.ansen.shape.AnsenLinearLayout>