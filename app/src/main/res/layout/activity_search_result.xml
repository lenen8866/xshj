<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.sda.books.reader.MainActivity"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="52dp"
                android:layout_marginEnd="13dp">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="13dp"
                    android:outlineProvider="none"
                    android:paddingLeft="18dp"
                    android:textColorHint="#FFCCCCCC"
                    android:textSize="14sp"
                    android:background="@drawable/search_border" />

                <RelativeLayout
                    android:id="@+id/search"
                    android:layout_width="47dp"
                    android:layout_height="40dp"
                    android:background="@drawable/search_button_border"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/icon_search"/>

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp"
            android:background="#f3fdff"
            android:visibility="gone"

            >

            <TextView
                android:id="@+id/tv_has_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:background="@color/tra"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_reset_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:text="重置搜索"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                />

        </LinearLayout>

        <!-- 顶部标签栏 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/category_tab"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:tabIndicator="@drawable/tab_indicator_layer"
            app:tabMode="scrollable"
            app:tabIndicatorColor="#FFFF7D0D"
            android:background="@android:color/transparent"
            app:tabTextAppearance="@style/categoryTxt"
            app:tabSelectedTextColor="#FFFF7D0D"
            app:tabGravity="start"
            android:outlineProvider="background" />

        <!-- 顶部标签栏 -->

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/sub_category_tab"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@android:color/transparent"
            app:tabGravity="start"
            app:tabIndicator="@drawable/tab_indicator_layer"
            app:tabIndicatorColor="#FFFF7D0D"
            app:tabMode="scrollable"
            app:tabTextAppearance="@style/subCategoryResultSelectTxt"
            app:tabSelectedTextColor="@color/black"
            app:tabTextColor="#FF979797" />
        <LinearLayout
            android:id="@+id/ll_search_result"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#333"
                android:textSize="14sp"
                android:text="在"
                android:visibility="gone"
                />
            <TextView
                android:id="@+id/tv_search_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#ff0000"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#333"
                android:textSize="14sp"
                android:text="共搜索到"
                />
            <TextView
                android:id="@+id/tv_search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#ff0000"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#333"
                android:textSize="14sp"
                android:text="个结果"
                />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_content_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>



    </LinearLayout>

    <RelativeLayout
        android:id="@+id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:paddingStart="15dp"
        android:background="@color/tra"
        android:paddingEnd="40dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="40dp"
            android:background="@color/tra"
            android:layout_height="40dp"
            android:src="@drawable/back" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>