<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name="com.sda.books.reader.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reader"
        android:hardwareAccelerated="false"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        tools:targetApi="31">
        <activity
            android:name="com.sda.books.reader.act.WelcomeAct"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.sda.books.reader.act.SecretAct"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sda.books.reader.AppCategoryPage"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sda.books.reader.AppVolumePage"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sda.books.reader.ChapterPage"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sda.books.reader.AppSettingPage"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sda.books.reader.AppSearchResultPage"
            android:screenOrientation="portrait" />
        <activity android:name="com.sda.books.reader.AppSearchAllFileResultPage"
            android:screenOrientation="portrait"
            />
        <activity
            android:name="com.sda.books.reader.act.AboutUsAct"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.sda.books.reader.AppUpdateDbPage"
            android:screenOrientation="portrait" />
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />
        <!--适配华为（huawei）刘海屏-->
        <meta-data
            android:name="android.notch_support"
            android:value="true"/>
        <!--适配小米（xiaomi）刘海屏-->
        <meta-data
            android:name="notch.config"
            android:value="portrait|landscape" />
    </application>

</manifest>