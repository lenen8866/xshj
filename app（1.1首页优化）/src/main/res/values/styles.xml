
<resources>
    <style name="categoryTxt" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>

    <style name="tabStyle">
        <item name="android:textSize">16sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF7B7B7B</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>
    <style name="tabSelectStyle">
        <item name="android:textSize">26sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFF7D0D</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>

    <style name="subTabStyle">
        <item name="android:textSize">16sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF979797</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>
    <style name="subTabSelectStyle">
        <item name="android:textSize">20sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF000000</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>


    <style name="categorySelectTxt" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">26sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>


    <style name="subCategorySelectTxt" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">20sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>

    <style name="subCategoryUnSelectTxt" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">20sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">bold</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>

    <style name="subCategoryResultSelectTxt" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">15sp</item> <!-- 设置文字大小 -->
        <item name="android:textStyle">normal</item>
        <!-- 其他可选属性：textAllCaps, fontFamily 等 -->
    </style>

    <style name="LoadingDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/LoadingDialogAnimation</item>
    </style>

    <style name="LoadingDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="OperateTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">14sp</item>
    </style>

    <declare-styleable name="SelectableTextView">
        <attr name="selected_color" format="color" />
        <attr name="cursor_handle_color" format="color"></attr>
    </declare-styleable>

    <style name="CustomTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorHeight">0dp</item> <!-- 如果不需要指示器，可以设置为0dp -->
        <item name="tabPaddingStart">8dp</item>
        <item name="tabPaddingEnd">8dp</item>
        <item name="tabBackground">@drawable/tab_selector</item> <!-- 使用自定义背景选择器 -->
    </style>
    <style name="Custom_Dialog_Style" parent="@android:style/Theme.Dialog">
        <!--窗口背景色透明-->
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowContentOverlay">@null</item>
        <!--是否浮在界面上-->
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <!-- 是否允许背景变暗 --> <!--背景是否模糊显示-->
        <item name="android:backgroundDimEnabled">true</item>
        <!--是否有标题-->
        <item name="android:windowNoTitle">true</item>
        <!--是否半透明-->
        <item name="android:windowIsTranslucent">true</item>
    </style>
    <!-- dialog底部弹出菜单动画 -->
    <style name="bottom_animation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/bottom_enter</item>
        <item name="android:windowExitAnimation">@anim/bottom_exit</item>
    </style>
</resources>