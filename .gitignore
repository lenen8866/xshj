# ✅ Gradle 缓存 & 构建输出（这些都是自动生成的，不要提交）
.gradle/
**/.gradle/
build/
**/build/

# ✅ Android Studio / IntelliJ 配置文件（每台电脑不同，不要提交）
.idea/
*.iml
*.ipr
*.iws
out/

# ✅ 本机配置（包含SDK路径等，每台电脑不同，不要提交）
local.properties

# ✅ 系统自动生成的文件（不要提交）
.DS_Store
Thumbs.db

# ✅ 日志文件（通常是运行时生成，不要提交）
*.log

# ✅ 数据库文件（通常是本地生成，不要提交）
*.db
# ✅ 本地文件（这样 主 app 不受影响，只忽略带括号的目录。，不要提交）
app(*)/
app（*）/
*.db-wal
*.db-shm
