<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="0dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <!-- 顶部标签栏 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/category_tab"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                app:tabIndicator="@drawable/tab_indicator_layer"
                app:tabMode="scrollable"
                app:tabIndicatorColor="#FFFF7D0D"
                android:background="@android:color/transparent"
                app:tabTextAppearance="@style/categoryTxt"
                app:tabGravity="start"
                app:tabRippleColor="@color/tra"
                app:tabTextColor="#FF7B7B7B" />

            <ImageView
                android:id="@+id/iv_setting"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/icon_setting"
                android:layout_marginEnd="17dp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="13dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="47dp"
                android:layout_weight="1"
                android:layout_marginEnd="13dp"
                android:outlineProvider="none"
                android:hint="关键词"
                android:paddingLeft="18dp"
                android:textColorHint="#FFCCCCCC"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/search_border" />

            <RelativeLayout
                android:id="@+id/search"
                android:layout_width="52dp"
                android:layout_height="47dp"
                android:background="@drawable/search_button_border"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/icon_search"
                    android:layout_centerInParent="true"/>

            </RelativeLayout>

        </LinearLayout>

        <!-- 内容区域 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rey_title"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:scrollbars="none"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rey_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>